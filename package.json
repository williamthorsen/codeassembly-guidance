  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "scripts": {
    "agents:install-launchers": "bash packages/guidance/scripts/install-launchers.sh",
    "agents:sync": "codeassembly sync",
    "bootstrap": "nmr build && pnpm run agents:sync",
    "check:strict:post": "pnpm --filter codeassembly-guidance run check:content",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "@williamthorsen/eslint-config-typescript": "21.0.0",
    "@williamthorsen/nmr": "catalog:",
    "@williamthorsen/release-kit": "17.0.1",
    "@williamthorsen/strict-lint": "14.2.1",
    "@williamthorsen/toolbelt.errors": "catalog:",
    "@williamthorsen/toolbelt.testing": "catalog:",
    "@williamthorsen/toolbelt.vitest": "catalog:",
    "@williamthorsen/tsconfig": "0.12.1",
    "codeassembly": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "4.4.5",
    "lefthook": "2.2.1",
    "prettier": "catalog:",
    "readyup": "catalog:",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "v11y-check": "1.0.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
